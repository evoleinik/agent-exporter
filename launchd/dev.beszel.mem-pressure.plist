<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Copy to ~/Library/LaunchAgents and replace HOME with your home directory. -->
<plist version="1.0">
<dict>
    <key>Label</key><string>dev.beszel.mem-pressure</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>HOME/.local/bin/mem-pressure.sh</string>
        <string>HOME/.local/state/mem-pressure/mem.prom</string>
        <string>10</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardErrorPath</key><string>HOME/Library/Logs/mem-pressure.log</string>
</dict>
</plist>
